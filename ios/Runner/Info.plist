<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>狗狗日历</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>狗狗日历</string>
	<key>NSCalendarsUsageDescription</key>
	<string>DoggyDays needs calendar access to keep your tasks and pet reminders together.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DoggyDays needs full calendar access to import your events and sync tasks created in the app.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>DoggyDays uses Face ID / Touch ID to protect your schedule and pet privacy.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DoggyDays uses your location in the background to detect when you enter or leave saved places, so it can switch pet scenes and trigger reminders like walks or vet visits.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DoggyDays uses your location while the app is open to let you set, review, and test saved places for geofence-based pet routines.</string>
	<key>NSMotionUsageDescription</key>
	<string>DoggyDays uses motion sensors to drive parallax and pet motion effects.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>DoggyDays uses notifications for walks, feeding, countdowns, and important events.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
